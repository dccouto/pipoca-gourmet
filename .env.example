# Local (recomendado): proxy Vite evita CORS / ORDS-13002 no browser
VITE_ORDS_BASE_URL=/ords
ORDS_PROXY_TARGET=https://XXXX-pipocag.adb.us-ashburn-1.oraclecloudapps.com

# Produção — NÃO use a URL crua do ADB no browser (ORDS-13002).
#
# Opção A (GitHub Pages + Worker):
#   Secret Actions VITE_ORDS_BASE_URL=https://pope-ords-proxy.<conta>.workers.dev/ords
#
# Opção B (Cloudflare Pages, same-origin):
#   Build com VITE_ORDS_BASE_URL=/ords
#   Secret/var do Pages: ORDS_PROXY_TARGET=<mesmo host ADB acima>
#
# Ver cloudflare/README.md
