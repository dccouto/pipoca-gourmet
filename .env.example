# Local (recomendado): proxy Vite evita CORS / ORDS-13002 no browser
VITE_ORDS_BASE_URL=/ords
ORDS_PROXY_TARGET=https://XXXX-pipocag.adb.us-ashburn-1.oraclecloudapps.com

# Produção (GitHub Pages): URL pública completa do ORDS
# Configure também o secret Actions VITE_ORDS_BASE_URL com o mesmo valor.
# Atenção: o ORDS ADB rejeita Origin (ORDS-13002); Pages precisa de proxy same-origin
# para admin/mutações — ver oracle/README-ORACLE.md
# VITE_ORDS_BASE_URL=https://XXXX-pipocag.adb.us-ashburn-1.oraclecloudapps.com/ords
